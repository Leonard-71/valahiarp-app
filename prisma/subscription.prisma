model Subscription {
    id            Int     @id @default(autoincrement())
    name          String  @unique
    description   String? @db.Text
    price         Decimal
    isRecommended Boolean @default(false)

    isArchived Boolean   @default(false)
    archivedAt DateTime?
    createdAt  DateTime  @default(now())
    updatedAt  DateTime  @updatedAt

    dependsOnParent   Subscription? @relation("SubscriptionDependency", fields: [dependsOnParentId], references: [id], onDelete: SetNull)
    dependsOnParentId Int?

    dependentSubscriptions Subscription[] @relation("SubscriptionDependency")

    category   Category @relation("CategorySubscriptions", fields: [categoryId], references: [id])
    categoryId Int

    location Location? @relation("SubscriptionLocation")

    documents Document[] @relation("SubscriptionDocuments")

    codes Code[] @relation("SubscriptionCodes")

    orders Order[] @relation("SubscriptionOrders")

    createdBy    User?   @relation("CreatedSubscriptions", fields: [createdById], references: [id], onDelete: SetNull)
    createdById  String?
    archivedBy   User?   @relation("ArchivedSubscriptions", fields: [archivedById], references: [id], onDelete: SetNull)
    archivedById String?

    @@map("subscriptions")
}
