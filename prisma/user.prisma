enum UserRole {
    ADMIN
    USER
}

model User {
    id                  String    @id @default(uuid())
    email               String    @unique
    stripeCustomerId    String?   @unique
    name                String?
    username            String?
    imageUrl            String?
    addressAttempts     Int       @default(0)
    addressBlockedUntil DateTime?
    role                UserRole  @default(USER)
    isArchived          Boolean   @default(false)
    archivedAt          DateTime?
    createdAt           DateTime  @default(now())
    updatedAt           DateTime  @updatedAt

    address   Address? @relation("UserAddress", fields: [addressId], references: [placeId])
    addressId String?

    codes Code[] @relation("UserCodes")

    orders Order[] @relation("UserOrders")

    archivedBy   User?   @relation("ArchivedUsers", fields: [archivedById], references: [id], onDelete: SetNull)
    archivedById String?

    createdCodes          Code[]          @relation("CreatedCodes")
    createdDocuments      Document[]      @relation("CreatedDocuments")
    createdCategories     Category[]      @relation("CreatedCategories")
    createdSubscriptions  Subscription[]  @relation("CreatedSubscriptions")
    createdLocations      Location[]      @relation("CreatedLocations")
    createdConfigurations Configuration[] @relation("CreatedConfigurations")
    createdHouses         House[]         @relation("CreatedHouses")

    archivedCodes          Code[]          @relation("ArchivedCodes")
    archivedDocuments      Document[]      @relation("ArchivedDocuments")
    archivedCategories     Category[]      @relation("ArchivedCategories")
    archivedSubscriptions  Subscription[]  @relation("ArchivedSubscriptions")
    archivedLocations      Location[]      @relation("ArchivedLocations")
    archivedConfigurations Configuration[] @relation("ArchivedConfigurations")
    archivedHouses         House[]         @relation("ArchivedHouses")
    archivedUsers          User[]          @relation("ArchivedUsers")

    @@map("users")
}
