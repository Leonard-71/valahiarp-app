model Location {
    id          Int       @id @default(autoincrement())
    xCoordinate Float
    yCoordinate Float
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    isArchived  Boolean   @default(false)
    archivedAt  DateTime?

    subscription   Subscription @relation("SubscriptionLocation", fields: [subscriptionId], references: [id], onDelete: Cascade)
    subscriptionId Int          @unique

    createdBy    User?   @relation("CreatedLocations", fields: [createdById], references: [id], onDelete: SetNull)
    createdById  String?
    archivedBy   User?   @relation("ArchivedLocations", fields: [archivedById], references: [id], onDelete: SetNull)
    archivedById String?

    @@map("locations")
}
